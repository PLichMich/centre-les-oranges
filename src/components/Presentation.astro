---
// src/components/Presentation.astro

const expertises = [
  {
    title: "Gestion des émotions",
    desc: "Psychologie, hypnose, sophrologie, kinésiologie et méditation pour vous aider à traverser l'anxiété ou le stress.",
    link: "/nos-services/psychologie",
    image: "/img/PETITE-FILLE.jpg"
  },
  {
    title: "Traitement de la douleur",
    desc: "Ostéopathie, podologie, ergonomie et soins paramédicaux pour soulager vos douleurs articulaires ou chroniques.",
    link: "/nos-services/osteopathie",
    image: "/img/KINE.jpg"
  },
  {
    title: "Aide à la parentalité",
    desc: "Neuropsychologie, logopédie, psychomotricité et médiation pour un accompagnement de la naissance à l'adolescence.",
    link: "/nos-services/psychologie",
    image: "/img/FAMILLE.jpg"
  },
  {
    title: "Nutrition & Santé",
    desc: "Diététique, nutrition et naturopathie pour retrouver un équilibre alimentaire ou adapter votre hygiène de vie.",
    link: "/nos-services/dietetique",
    image: "/img/DIET.jpg"
  },
  {
    title: "Prélèvements CHU Tivoli",
    desc: "Prises de sang et analyses médicales assurées par des infirmiers hospitaliers. Ouvert à tous, sans rendez-vous.",
    link: "/centre-de-prelevements-chu-tivoli",
    image: "/img/prise-de-rendez-vous.jpg" // À adapter si tu as nommé cette photo autrement
  }
];
---

<!-- 1. NOTRE PHILOSOPHIE (Fond Gris Chaud / Greige) -->
<section class="py-16 bg-stone-100 border-y border-stone-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center md:text-left divide-y md:divide-y-0 md:divide-x divide-stone-300/70">
      
      <div class="md:pr-8 pt-8 md:pt-0 group">
        <h3 class="text-stone-900 text-lg font-bold mb-3 flex flex-col md:block items-center gap-2">
          <span class="text-amber-500 mr-2 text-xl group-hover:scale-125 inline-block transition-transform">●</span> 
          Prise en charge globale
        </h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Nous traitons la santé dans son entièreté : symptômes physiques, psychologiques, équilibre alimentaire et sommeil.
        </p>
      </div>

      <div class="md:px-8 pt-8 md:pt-0 group">
        <h3 class="text-stone-900 text-lg font-bold mb-3 flex flex-col md:block items-center gap-2">
          <span class="text-amber-500 mr-2 text-xl group-hover:scale-125 inline-block transition-transform">●</span> 
          Équipe pluridisciplinaire
        </h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Médecins, paramédicaux et thérapeutes échangent et collaborent (avec votre accord) pour vous offrir le meilleur suivi possible.
        </p>
      </div>

      <div class="md:pl-8 pt-8 md:pt-0 group">
        <h3 class="text-stone-900 text-lg font-bold mb-3 flex flex-col md:block items-center gap-2">
          <span class="text-amber-500 mr-2 text-xl group-hover:scale-125 inline-block transition-transform">●</span> 
          Soins accessibles
        </h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Un accompagnement rapide et professionnel, avec la possibilité d'obtenir des remboursements via votre mutuelle.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- 2. NOS DOMAINES D'EXPERTISE (Fond très clair et lumineux) -->
<section class="py-24 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- En-tête -->
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
        Ce que nous traitons
      </h2>
      <p class="text-lg text-stone-600">
        Quel que soit votre âge ou votre situation, notre équipe vous accompagne à travers 5 grands pôles de soins.
      </p>
    </div>

    <!-- La grille de cartes blanches -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {expertises.map((item) => (
        <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-hidden flex flex-col group hover:shadow-lg hover:-translate-y-1 hover:border-amber-200 transition-all duration-300">
          <div class="h-48 overflow-hidden bg-stone-100">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-stone-900 mb-2">
              {item.title}
            </h3>
            <p class="text-stone-600 text-sm leading-relaxed mb-6 flex-grow">
              {item.desc}
            </p>
            <a href={item.link} class="inline-flex items-center gap-2 text-sm font-bold text-amber-600 group-hover:text-amber-700 transition-colors mt-auto">
              Découvrir <span class="transform transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>
      ))}

      <!-- Carte Action "Annuaire" intégrée harmonieusement -->
      <div class="bg-gradient-to-br from-amber-50 to-orange-50/50 rounded-2xl border border-amber-200/60 p-8 flex flex-col justify-center items-start group hover:border-amber-300 transition-colors shadow-sm">
        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-stone-900 mb-3">
          Un besoin spécifique ?
        </h3>
        <p class="text-stone-600 mb-6 text-sm leading-relaxed">
          Consultez notre annuaire complet. Vous y trouverez tous nos praticiens filtrables par discipline.
        </p>
        <a href="/annuaire" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold text-white bg-amber-600 rounded-xl hover:bg-amber-700 transition-colors shadow-sm">
          Voir l'annuaire des thérapeutes
        </a>
      </div>

    </div>

  </div>
</section>