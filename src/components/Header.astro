---
// src/components/Header.astro

// ==========================================
// L'ARBRE DE NAVIGATION CENTRAL (JSON)
// ==========================================
const navData = [
  {
    label: "Le Centre",
    type: "mega-centre",
    id: "panel-centre",
    columns: 
    [
      {
        title: "Découvrir le Centre",
        items: [
          { label: "Le Centre & Philosophie", link: "/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/le-centre-therapeutique-les-oranges" },
          { label: "Galerie photos", link: "/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/galerie-photo" },
          { label: "Accès & Plan", link: "/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/venir-jusqua-nous" },
          { label: "Accès & Plan (Test doublon)", link: "/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/venir-jusqua-nous" } // <-- Ton test est ici !
        ]
      },
      {
        title: "Professionnels de santé",
        items: [
          { label: "• Location de cabinets", link: "/bureau-a-louer-pour-medecins-specialistes-personnel-de-sante-independants" },
          { label: "• Offre Kiné", link: "/envie-de-rejoindre-notre-equipe/offre-demploi-kinesitherapeute-independant" },
          { label: "• Offre Logopède", link: "/envie-de-rejoindre-notre-equipe/offre-demploi-logopede-independante" }
        ]
      }
    ]
  },
    {
    label: "Notre Équipe",
    type: "link",
    link: "/annuaire"
  },
  {
    label: "Choisir son spécialiste",
    type: "mega-specialistes",
    id: "panel-specialistes",
    poles: [
      {
        id: "pole-psy",
        title: "Psychologie & Mental",
        shortTitle: "Psychologie",
        disciplines: [
          {
            name: "Psychothérapie TCC",
            link: "/nos-services/psychologie/psychologie-cognitive-et-comportementale",
            practitioners: [
              { name: "M. Plichart", link: "/nos-services/psychologie/psychologie-cognitive-et-comportementale/therapie-cognitivo-comportementale-binche-plichart" },
              { name: "C. Mahieu", link: "/nos-services/psychologie/psychologie-cognitive-et-comportementale/mahieux-celine-psychologue-tcc" }
            ]
          },
          {
            name: "EMDR & Traumatismes",
            link: "/nos-services/psychologie/emdr-eye-movement-desensitization-and-reprocessing",
            practitioners: [
              { name: "D. Cisamolo", link: "/daniela-cisamolo-psychologue-therapeute-emdr-pdmy-coach-amoureux-sexologue" },
              { name: "G. Trunfio", link: "/giovanna-trunfio-psychologue" }
            ]
          }
        ]
      },
      {
        id: "pole-paramedical",
        title: "Paramédical & Rééducation",
        shortTitle: "Paramédical & Corps",
        disciplines: [
          { name: "Ostéopathie", link: "/nos-services/osteopathie", practitioners: [{ name: "M. Grégoire", link: "/osteopathe-d-o" }] },
          { name: "Logopédie", link: "/nos-services/logopedie", practitioners: [] }
        ]
      },
      {
        id: "pole-bienetre",
        title: "Bien-être & Corps",
        shortTitle: "Bien-être & Nutrition",
        disciplines: [
          { 
            name: "Diététique & Nutrition", 
            link: "/nos-services/dietetique", 
            practitioners: [{ name: "C. Delbruyère", link: "/delbruyere-clementine-dieteticienne-nutritionniste" }] 
          },
          { 
            name: "Sophrologie & Massages", 
            link: "/nos-services/sophrologie", 
            practitioners: [{ name: "C. Malosto", link: "/nos-services/sophrologie/malosto-cathy-sophrologue-et-massotherapeute" }] 
          },
          { 
            name: "Kinésiologie & Brain Gym", 
            link: "/nos-services/kinesiologie", 
            practitioners: [{ name: "C. Di Meo", link: "/nos-services/kinesiologie/cristina-di-meo-kinesiologue-instructrice-brain-gym" }] 
          },
          { 
            name: "Médiation familiale", 
            link: "/nos-services/mediation-familiale", 
            practitioners: [{ name: "G. D'Hoop", link: "/gwendoline-dhoop-juriste-et-mediatrice" }] 
          },
          { 
            name: "Naturopathie", 
            link: "/naturopathie", 
            practitioners: [] 
          },
          { 
            name: "Yoga & Pilates", 
            link: "/yoga", 
            practitioners: [] 
          }
        ]
      },
      {
        id: "pole-prelevements",
        title: "Prélèvements CHU Tivoli",
        shortTitle: "Prélèvements Tivoli",
        isSpecial: true,
        link: "/centre-de-prelevements-chu-tivoli"
      }
    ]
  },
  {
    label: "Ateliers de groupes",
    type: "link",
    link: "/nos-services/ateliers-formations-a-venir"
  },
  {
    label: "Actualité",
    type: "link",
    link: "/les-nouvelles-du-centre"
  }
];
---

<div id="menu-backdrop" class="fixed inset-0 bg-stone-900/60 backdrop-blur-sm z-30 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<header class="sticky top-0 z-40 bg-stone-900 border-b border-stone-800 shadow-md">
  
  <!-- TOP BAR -->
  <div class="bg-stone-950 text-stone-400 text-xs py-2 px-4 border-b border-stone-800/50">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-4 flex-wrap">
        <span class="flex items-center gap-1.5 text-stone-300">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Rue Joseph Wauters 191, Péronnes-lez-Binche
        </span>
      </div>
      <div class="flex items-center gap-4">
        <a href="tel:0486261979" class="hover:text-amber-400 transition-colors font-medium text-stone-200">0486 / 26.19.79</a>
      </div>
    </div>
  </div>

  <!-- BARRE DE NAVIGATION PRINCIPALE (Générée depuis le JSON) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
<a href="/" class="flex items-center gap-3 group">
      <!-- Le logo est maintenant parfaitement rond grâce à "rounded-full" -->
      <img 
        src="/img/logo-cartoon.jpg" 
        alt="Logo Centre Thérapeutique Les Oranges" 
        class="w-12 h-12 rounded-full object-cover border border-stone-700 shadow-sm group-hover:scale-105 transition-transform duration-300 bg-white"
      />
      <div>
        <span class="font-['Lora',serif] text-xl font-bold tracking-tight text-white block leading-tight">Les Oranges</span>
        <span class="text-[11px] uppercase tracking-wider font-semibold text-amber-500 block mt-0.5">Centre Thérapeutique</span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {navData.map(item => {
        if (item.type === "link") {
          return <a href={item.link} class="px-3.5 py-2 text-sm font-medium text-stone-200 hover:text-amber-400 rounded-lg transition-colors">{item.label}</a>
        } else {
          return (
            <button type="button" class="nav-tab-btn flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium text-stone-200 hover:text-amber-400 rounded-lg transition-colors" data-target={item.id}>
              <span>{item.label}</span>
              <svg class="chevron-icon w-3.5 h-3.5 text-stone-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
          )
        }
      })}
    </nav>

    <div class="hidden sm:flex items-center gap-3">
      <a href="/annuaire" class="inline-flex items-center px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-stone-900 bg-amber-500 hover:bg-amber-400 rounded-full shadow-sm transition-all">Prendre RDV</a>
    </div>

    <button id="mobile-toggle" type="button" class="lg:hidden p-2 rounded-lg text-stone-200 hover:bg-stone-800" aria-label="Menu mobile">
      <svg id="burger-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="close-icon" class="hidden w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- MEGA-MENUS DESKTOP (Générés depuis le JSON) -->
  <div id="mega-menu-container" class="hidden border-t-4 border-amber-500 bg-stone-50 shadow-2xl transition-all duration-300 absolute w-full">
    
    {navData.map(menuItem => {
      
      // RENDU DU MENU "LE CENTRE"
      if (menuItem.type === "mega-centre") {
        return (
          <div id={menuItem.id} class="mega-panel hidden max-w-7xl mx-auto px-6 py-10">
            <div class="grid grid-cols-12 gap-8">
              {menuItem.columns.map(col => (
                <div class="col-span-4 border-r border-stone-200 pr-6">
                  <h3 class="text-xs uppercase font-bold tracking-widest text-amber-800 pb-2 border-b border-stone-200 mb-4">{col.title}</h3>
                  <ul class="space-y-3 text-sm">
                    {col.items.map(link => (
                      <li><a href={link.link} class="font-semibold text-stone-900 hover:text-amber-700">{link.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="col-span-4">
                <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
                  <h4 class="font-bold text-stone-900 text-base mb-2">Contacter le Centre</h4>
                  <a href="/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/contacter-les-gestionnaires-du-centre" class="w-full inline-flex items-center justify-center py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-stone-900 hover:bg-stone-800 mt-4">Formulaire de contact</a>
                </div>
              </div>
            </div>
          </div>
        )
      }

      // RENDU DU MENU "SPÉCIALISTES"
      if (menuItem.type === "mega-specialistes") {
        return (
          <div id={menuItem.id} class="mega-panel hidden max-w-7xl mx-auto px-6 py-8">
            <div class="grid grid-cols-12 gap-8 min-h-[460px]">
              
              <!-- Colonne Navigation des Pôles -->
              <div class="col-span-3 border-r border-stone-200 pr-6 space-y-2">
                <span class="text-[11px] uppercase font-bold tracking-widest text-stone-400 block mb-3">Pôles thérapeutiques</span>
                {menuItem.poles.map((pole, index) => (
                  <button type="button" class={`pole-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center justify-between transition-colors ${index === 0 ? 'active-pole bg-amber-100/50 text-amber-900 border border-amber-200/60 font-semibold' : 'text-stone-700 font-medium hover:bg-stone-100 border border-transparent'}`} data-pole={pole.id}>
                    <span>{pole.title}</span><span class="text-xs opacity-60">→</span>
                  </button>
                ))}
              </div>

              <!-- Contenu des Pôles -->
              <div class="col-span-9">
                {menuItem.poles.map((pole, index) => {
                  
                  if (pole.isSpecial) {
                    return (
                      <div id={pole.id} class="pole-content hidden">
                        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
                          <h3 class="text-lg font-bold text-stone-900 mb-2">{pole.title}</h3>
                          <p class="text-sm text-stone-600 mb-4">Sans rendez-vous. Entrée rue Albert Elisabeth.</p>
                          <a href={pole.link} class="inline-block px-4 py-2 bg-emerald-100 text-emerald-800 rounded-lg text-sm font-bold">Voir les horaires et consignes</a>
                        </div>
                      </div>
                    )
                  }

                  return (
                    <div id={pole.id} class={`pole-content grid grid-cols-2 gap-6 ${index === 0 ? '' : 'hidden'}`}>
                      <div class="space-y-4">
                        {pole.disciplines.slice(0, Math.ceil(pole.disciplines.length / 2)).map(discipline => (
                          <div class="p-3 bg-white rounded-xl border border-stone-200/80 shadow-sm">
                            <a href={discipline.link} class="font-bold text-sm text-stone-900 hover:text-amber-700 block mb-1">{discipline.name}</a>
                            {discipline.practitioners.length > 0 && (
                              <div class="flex flex-wrap gap-1 mt-2 text-xs">
                                {discipline.practitioners.map(prac => (
                                  <a href={prac.link} class="px-2 py-1 bg-stone-100 hover:bg-amber-100 rounded">{prac.name}</a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                      <div class="space-y-4">
                        {pole.disciplines.slice(Math.ceil(pole.disciplines.length / 2)).map(discipline => (
                          <div class="p-3 bg-white rounded-xl border border-stone-200/80 shadow-sm">
                            <a href={discipline.link} class="font-bold text-sm text-stone-900 hover:text-amber-700 block mb-1">{discipline.name}</a>
                            {discipline.practitioners.length > 0 && (
                              <div class="flex flex-wrap gap-1 mt-2 text-xs">
                                {discipline.practitioners.map(prac => (
                                  <a href={prac.link} class="px-2 py-1 bg-stone-100 hover:bg-amber-100 rounded">{prac.name}</a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )
                })}
              </div>

            </div>
          </div>
        )
      }
    })}
  </div>

  <!-- TIROIR RESPONSIVE MOBILE (Généré depuis le JSON) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t-4 border-amber-500 bg-white absolute w-full shadow-xl max-h-[85vh] overflow-y-auto">
    <div class="p-4 space-y-1">
      
      {navData.map(item => {
        if (item.type === "link") {
          return <a href={item.link} class="block px-4 py-3 text-lg font-bold text-stone-900 hover:bg-stone-50 rounded-xl">{item.label}</a>
        }
        
        if (item.type === "mega-centre") {
          return (
            <div class="mobile-accordion">
              <button class="mobile-accordion-btn flex items-center justify-between w-full px-4 py-3 text-lg font-bold text-stone-900 hover:bg-stone-50 rounded-xl">
                <span>{item.label}</span>
                <svg class="w-5 h-5 text-stone-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="mobile-accordion-content hidden px-4 pb-3 space-y-1 bg-stone-50 rounded-xl mt-1 p-2">
                {item.columns.map(col => (
                  col.items.map(link => (
                    <a href={link.link} class="block text-sm py-2 px-2 text-stone-700">{link.label}</a>
                  ))
                ))}
              </div>
            </div>
          )
        }

        if (item.type === "mega-specialistes") {
          return (
            <div class="mobile-accordion">
              <button class="mobile-accordion-btn flex items-center justify-between w-full px-4 py-3 text-lg font-bold text-stone-900 hover:bg-stone-50 rounded-xl">
                <span>{item.label}</span>
                <svg class="w-5 h-5 text-stone-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="mobile-accordion-content hidden px-4 pb-3 space-y-4 bg-stone-50 rounded-xl mt-1 p-4">
                {item.poles.map(pole => {
                  if(pole.isSpecial) return <a href={pole.link} class="block text-sm font-bold text-emerald-700 py-1.5">{pole.shortTitle}</a>
                  return (
                    <div>
                      <h4 class="font-bold text-amber-800 uppercase text-xs tracking-wider mb-2">{pole.shortTitle}</h4>
                      {pole.disciplines.map(discipline => (
                        <a href={discipline.link} class="block text-sm py-1.5 text-stone-700">{discipline.name}</a>
                      ))}
                    </div>
                  )
                })}
              </div>
            </div>
          )
        }
      })}

      <div class="pt-4 mt-2 border-t border-stone-100">
        <a href="/annuaire" class="w-full flex items-center justify-center py-4 text-base font-bold uppercase tracking-wider text-stone-900 bg-amber-500 rounded-xl shadow-sm">
          Annuaire & RDV
        </a>
      </div>
    </div>
  </div>

</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. MEGA-MENU DESKTOP
    const tabBtns = document.querySelectorAll('.nav-tab-btn');
    const megaContainer = document.getElementById('mega-menu-container');
    const megaPanels = document.querySelectorAll('.mega-panel');
    const backdrop = document.getElementById('menu-backdrop');
    let currentActiveTab = null;

    function closeMegaMenu() {
      if(megaContainer) megaContainer.classList.add('hidden');
      megaPanels.forEach(p => p.classList.add('hidden'));
      if(backdrop) {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      }
      tabBtns.forEach(btn => {
        btn.classList.remove('text-amber-400');
        const icon = btn.querySelector('.chevron-icon');
        if(icon) icon.classList.remove('rotate-180');
      });
      currentActiveTab = null;
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId || !megaContainer) return;

        if (currentActiveTab === targetId) {
          closeMegaMenu();
          return;
        }

        currentActiveTab = targetId;
        megaContainer.classList.remove('hidden');
        megaPanels.forEach(p => p.classList.add('hidden'));
        const targetPanel = document.getElementById(targetId);
        if(targetPanel) targetPanel.classList.remove('hidden');

        if(backdrop) {
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100', 'pointer-events-auto');
        }

        tabBtns.forEach(b => {
          const isCurrent = b === btn;
          b.classList.toggle('text-amber-400', isCurrent);
          const icon = b.querySelector('.chevron-icon');
          if(icon) icon.classList.toggle('rotate-180', isCurrent);
        });
      });
    });

    if(backdrop) backdrop.addEventListener('click', closeMegaMenu);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMegaMenu(); });

    // 2. BASCULE PÔLES DESKTOP
    const poleBtns = document.querySelectorAll('.pole-btn');
    const poleContents = document.querySelectorAll('.pole-content');

    poleBtns.forEach(btn => {
      const activatePole = () => {
        const targetPole = btn.getAttribute('data-pole');
        if (!targetPole) return;

        poleBtns.forEach(b => {
          b.classList.remove('bg-amber-100/50', 'text-amber-900', 'border-amber-200/60', 'font-semibold');
          b.classList.add('text-stone-700', 'font-medium', 'border-transparent');
        });

        btn.classList.add('bg-amber-100/50', 'text-amber-900', 'border-amber-200/60', 'font-semibold');
        btn.classList.remove('text-stone-700', 'font-medium', 'border-transparent');

        poleContents.forEach(c => c.classList.add('hidden'));
        const targetContent = document.getElementById(targetPole);
        if(targetContent) targetContent.classList.remove('hidden');
      };
      btn.addEventListener('mouseenter', activatePole);
      btn.addEventListener('click', activatePole);
    });

    // 3. BURGER MOBILE
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');
    const closeIcon = document.getElementById('close-icon');

    if(mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        if(burgerIcon && closeIcon) {
          burgerIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        }
      });
    }

    const accordionBtns = document.querySelectorAll('.mobile-accordion-btn');
    accordionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        if(content) {
          content.classList.toggle('hidden');
          if(icon) icon.classList.toggle('rotate-180');
        }
      });
    });
  });
</script>