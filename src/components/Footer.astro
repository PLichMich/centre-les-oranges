---
// src/components/Footer.astro
const anneeEnCours = new Date().getFullYear();
---

<footer class="bg-stone-950 pt-16 pb-8 border-t border-stone-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      
      <!-- Colonne 1 : À propos -->
      <div>
        <span class="font-['Lora',serif] text-2xl font-bold tracking-tight text-white block mb-1">Les Oranges</span>
        <span class="text-xs uppercase tracking-wider font-semibold text-amber-500 block mb-6">Centre Thérapeutique</span>
        <p class="text-stone-400 text-sm leading-relaxed mb-6">
          Une approche pluridisciplinaire et humaine pour votre santé physique et mentale, réunie en un seul lieu.
        </p>
        <div class="flex items-start gap-3 text-sm text-stone-400">
          <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Rue Joseph Wauters 191<br/>7110 Péronnes-lez-Binche</span>
        </div>
      </div>

      <!-- Colonne 2 : Liens rapides -->
      <div>
        <h3 class="text-stone-100 font-bold mb-6 uppercase tracking-wider text-sm">Navigation</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-stone-400 hover:text-amber-500 transition-colors text-sm">Accueil</a></li>
          <li><a href="/annuaire" class="text-stone-400 hover:text-amber-500 transition-colors text-sm">Annuaire des praticiens</a></li>
          <li><a href="/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/le-centre-therapeutique-les-oranges" class="text-stone-400 hover:text-amber-500 transition-colors text-sm">Découvrir le Centre</a></li>
          <li><a href="/centre-de-prelevements-chu-tivoli" class="text-stone-400 hover:text-amber-500 transition-colors text-sm">Prélèvements CHU Tivoli</a></li>
          <li><a href="/bienvenue-sur-le-site-internet-du-centre-therapeutique-les-oranges/contacter-les-gestionnaires-du-centre" class="text-stone-400 hover:text-amber-500 transition-colors text-sm">Contact & Accès</a></li>
        </ul>
      </div>

      <!-- Colonne 3 : Contact & Infos -->
      <div>
        <h3 class="text-stone-100 font-bold mb-6 uppercase tracking-wider text-sm">Nous contacter</h3>
        <a href="tel:0486261979" class="inline-flex items-center gap-3 text-stone-300 hover:text-amber-400 transition-colors mb-4 group">
          <div class="w-10 h-10 rounded-full bg-stone-900 border border-stone-800 flex items-center justify-center group-hover:border-amber-500/50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <span class="font-medium">0486 / 26.19.79</span>
        </a>
        <div class="bg-stone-900 border border-stone-800 rounded-xl p-4 mt-2">
          <p class="text-xs text-stone-400 leading-relaxed">
            <strong class="text-stone-300">Attention :</strong> Ce numéro permet de contacter la gestion du centre. Pour prendre rendez-vous, veuillez contacter directement le praticien via sa fiche dans l'annuaire.
          </p>
        </div>
      </div>

    </div>

    <!-- Bas de page -->
    <div class="pt-8 border-t border-stone-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-stone-500">
      <p>&copy; {anneeEnCours} Centre Thérapeutique Les Oranges. Tous droits réservés.</p>
    </div>
  </div>
</footer>