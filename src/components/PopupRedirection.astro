---
// src/components/PopupRedirection.astro

const { praticien } = Astro.props;
---

{praticien.statut === 'absent' && praticien.redirection_url && (
  <Fragment>
    <!-- Le fond sombre et la fenêtre du Pop-up -->
    <div id="redirect-modal" class="fixed inset-0 z-50 flex items-center justify-center px-4 bg-slate-900/80 backdrop-blur-sm opacity-0 transition-opacity duration-500 pointer-events-none">
      <div id="redirect-box" class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 text-center transform scale-95 transition-transform duration-500 pointer-events-auto">
        
        <!-- Icône d'information -->
        <div class="w-16 h-16 bg-orange-100 text-orange-700 rounded-full flex items-center justify-center mx-auto mb-5">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        
        <h3 class="font-['Lora',serif] text-2xl font-bold text-slate-900 mb-3">Information</h3>
        
        <!-- Le message issu de equipe.json -->
        <p class="text-slate-600 mb-6 leading-relaxed">
          {praticien.message_statut}
        </p>
        
        <!-- Compte à rebours visuel -->
        <div class="bg-slate-50 rounded-xl p-4 mb-6 border border-slate-100">
          <p class="text-sm font-medium text-slate-700">
            Redirection automatique dans <br/>
            <span id="countdown-timer" class="text-3xl font-bold text-orange-700 block mt-2">5</span>
          </p>
        </div>
        
        <!-- Bouton pour ne pas attendre -->
        <a href={praticien.redirection_url} class="inline-block w-full py-3.5 px-6 text-white font-bold bg-slate-900 hover:bg-orange-800 rounded-xl transition-colors shadow-md">
          {praticien.redirection_texte || "Continuer maintenant"}
        </a>

      </div>
    </div>

    <!-- Le script d'animation et de décompte -->
    <script is:inline define:vars={{ url: praticien.redirection_url }}>
      document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('redirect-modal');
        const box = document.getElementById('redirect-box');
        const timerSpan = document.getElementById('countdown-timer');

        if (modal && box && timerSpan) {
          // Fait apparaître le pop-up en douceur
          setTimeout(() => {
            modal.classList.remove('opacity-0');
            box.classList.remove('scale-95');
          }, 500);

          // Gère le compte à rebours
          let timeLeft = 5;
          const countdown = setInterval(() => {
            timeLeft--;
            timerSpan.textContent = timeLeft;
            
            if (timeLeft <= 0) {
              clearInterval(countdown);
              window.location.href = url;
            }
          }, 1000);
        }
      });
    </script>
  </Fragment>
)}