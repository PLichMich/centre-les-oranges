---
import { Image } from 'astro:assets';
// Importation directe depuis le dossier assets pour forcer l'optimisation
import photoCentre from '../assets/centre-exterieur.jpg'; 
---

<section class="relative bg-stone-50 overflow-hidden border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 py-16 lg:py-24 items-center">
      
      <!-- Texte -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-stone-200 mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-stone-600">Péronnes-lez-Binche</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 tracking-tight leading-[1.1] mb-6">
          Votre santé globale, <span class="text-orange-600">notre priorité.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-stone-600 mb-8 leading-relaxed">
          Une équipe pluridisciplinaire unie pour vous offrir des soins de qualité, abordables et dans les meilleurs délais.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a href="/annuaire" class="inline-flex justify-center items-center gap-2 px-8 py-4 text-sm font-bold text-white bg-orange-600 hover:bg-orange-700 rounded-xl shadow-md transition-colors">
            Trouver mon spécialiste
          </a>
          <a href="/centre-de-prelevements-chu-tivoli" class="inline-flex justify-center items-center gap-2 px-8 py-4 text-sm font-bold text-stone-700 bg-white border border-stone-200 hover:bg-stone-50 rounded-xl transition-colors shadow-sm">
            Prises de sang (Sans RDV)
          </a>
        </div>
      </div>

      <!-- Image optimisée -->
      <div class="relative lg:ml-auto w-full max-w-lg lg:max-w-none">
        <!-- Décoration d'arrière-plan épurée -->
        <div class="absolute -inset-2 bg-gradient-to-tr from-orange-100 to-stone-200 rounded-3xl transform rotate-2 -z-10"></div>
        
        <!-- Le composant Image va générer un format WebP net et léger -->
        <Image 
          src={photoCentre} 
          alt="Accueil du Centre Thérapeutique Les Oranges" 
          class="w-full h-[400px] lg:h-[500px] object-cover rounded-2xl shadow-lg border border-white"
          width={800}
          height={600}
          quality="max"
        />
        
        <!-- Badge flottant informatif -->
        <div class="absolute -bottom-6 -left-6 sm:left-6 bg-white p-4 rounded-xl shadow-lg border border-stone-100 flex items-center gap-4">
          <div class="w-10 h-10 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center font-bold text-lg">
            +24
          </div>
          <div>
            <p class="text-sm font-bold text-stone-900">Spécialistes</p>
            <p class="text-xs text-stone-500">À votre écoute</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>