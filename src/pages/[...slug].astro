---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import equipeData from '../data/equipe.json';

export async function getStaticPaths() {
  return equipeData.map((pro) => {
    const slug = pro.link.startsWith('/') ? pro.link.slice(1) : pro.link;
    return {
      params: { slug },
      props: { pro },
    };
  });
}

const { pro } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/equipe/*.{jpeg,jpg,png,webp}');
const textes = import.meta.glob('/src/assets/textes/*.md', { eager: true });

const fichierTexte = pro.fichier_texte ? textes[`/src/assets/textes/${pro.fichier_texte}`] : null;
const Content = fichierTexte ? (fichierTexte as any).Content : null;

// NOUVEAU : On extrait le chemin exact de l'image optimisée par Astro pour l'envoyer au Layout
const imageModule = images[`/src/assets/equipe/${pro.photo}`] ? await images[`/src/assets/equipe/${pro.photo}`]() : null;
const imageSrc = imageModule ? imageModule.default.src : undefined;
---

<Layout 
  title={`${pro.nom} - ${pro.metier} | Centre Les Oranges`}
  description={`Prenez rendez-vous avec ${pro.nom}, ${pro.metier} au Centre Thérapeutique Les Oranges à Péronnes-lez-Binche.`}
  image={imageSrc}
>
  <!-- FOND PLUS CONTRASTÉ : bg-stone-100 -->
  <div class="bg-stone-200 min-h-screen pb-24 pt-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Fil d'Ariane -->
      <nav class="flex text-sm text-stone-500 mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-2">
          <li><a href="/" class="hover:text-amber-600 transition-colors">Accueil</a></li>
          <li><span class="mx-2">/</span></li>
          <li><a href="/annuaire" class="hover:text-amber-600 transition-colors">Annuaire</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-stone-900 font-semibold" aria-current="page">{pro.nom}</li>
        </ol>
      </nav>

      <!-- CARTE PRINCIPALE : Ombre forte (shadow-xl) -->
      <div class="bg-white rounded-3xl shadow-xl shadow-stone-200/60 border border-stone-200 overflow-hidden">
        
        <!-- Banderole d'en-tête -->
        <div class="h-32 sm:h-40 bg-gradient-to-r from-orange-600 to-amber-500"></div>
        
        <div class="px-6 sm:px-10 pb-8">
          <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-end mb-8">
            
            <!-- Photo du praticien -->
            <div class="relative -mt-16 sm:-mt-20 z-10 flex-shrink-0">
              <div class="rounded-full border-4 border-white bg-white shadow-lg overflow-hidden w-32 h-32 sm:w-40 sm:h-40">
                {images[`/src/assets/equipe/${pro.photo}`] ? (
                  <Image 
                    src={images[`/src/assets/equipe/${pro.photo}`]()} 
                    alt={pro.nom}
                    width={160} 
                    height={160}
                    class={`w-full h-full object-cover ${pro.statut === 'absent' ? 'grayscale opacity-80' : ''}`}
                  />
                ) : (
                  <div class="w-full h-full bg-stone-100 flex items-center justify-center text-stone-400 text-sm">
                    Pas de photo
                  </div>
                )}
              </div>
            </div>

            <!-- Textes Identité -->
            <div class="flex-grow text-center sm:text-left pt-2 sm:pt-0">
              <h1 class="font-['Lora',serif] text-3xl sm:text-4xl font-bold text-stone-900 mb-2">
                {pro.nom}
              </h1>
              <p class="text-base sm:text-lg font-bold uppercase tracking-widest text-amber-600 mb-4">
                {pro.metier}
              </p>
              <div class="flex flex-wrap justify-center sm:justify-start gap-2">
                {pro.tags && pro.tags.map((tag: string) => (
                  <span class="px-3 py-1 bg-stone-100 text-stone-700 text-xs font-semibold rounded-full border border-stone-200">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Grille Contenu et Sidebar -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 border-t border-stone-100 pt-10">
            
            <!-- Colonne de gauche (Markdown SEO) -->
            <div class="lg:col-span-2">
              <div class="prose prose-stone max-w-none">
                {Content ? (
                  <Content />
                ) : (
                  <div class="bg-stone-50 rounded-xl p-6 text-center italic text-stone-500">
                    Le profil détaillé de ce praticien sera bientôt disponible.
                  </div>
                )}
              </div>
            </div>

            <!-- Colonne de droite (Widgets) -->
            <div class="space-y-6">
              
              <!-- Widget 1 : Prendre Rendez-vous -->
              <div class="bg-stone-50 rounded-2xl p-6 border border-stone-200">
                <h3 class="font-bold text-stone-900 mb-4">Prendre rendez-vous</h3>
                {pro.statut !== 'absent' ? (
                  <div class="space-y-4">
                    <a href="/prendre-rendez-vous" class="flex justify-center w-full py-3 px-4 bg-stone-900 hover:bg-amber-600 text-white text-sm font-bold rounded-xl transition-all duration-200 shadow-sm hover:shadow-md">
                      RDV en ligne
                    </a>
                    <p class="text-xs text-stone-500 text-center leading-relaxed">
                      Gérez vos rendez-vous 24h/24 et 7j/7 via notre plateforme sécurisée.
                    </p>
                  </div>
                ) : (
                  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                    <span class="block text-xs font-bold uppercase tracking-widest text-amber-800 mb-2">Absent(e)</span>
                    <p class="text-sm font-medium text-amber-900 mb-4">{pro.message_statut}</p>
                    {pro.redirection_url && (
                      <a href={pro.redirection_url} class="inline-block w-full py-2 px-4 bg-white text-amber-900 border border-amber-300 text-xs font-bold rounded-lg hover:bg-amber-50 transition-colors">
                        {pro.redirection_texte || "Voir un autre spécialiste"}
                      </a>
                    )}
                  </div>
                )}
              </div>

              <!-- Widget 2 : Localisation Google Maps -->
              <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
                <h3 class="font-bold text-stone-900 mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  Lieu de consultation
                </h3>
                
                <div class="w-full h-48 rounded-xl overflow-hidden border border-stone-200 mb-4">
                  <iframe 
                    src="https://maps.google.com/maps?q=Rue+Joseph+Wauters+191,+7110+Péronnes-lez-Binche&t=&z=14&ie=UTF8&iwloc=&output=embed" 
                    width="100%" 
                    height="100%" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                  </iframe>
                </div>

                <p class="text-sm text-stone-600 mb-4 leading-relaxed">
                  <strong>Centre Les Oranges</strong><br/>
                  Rue Joseph Wauters 191<br/>
                  7110 Péronnes-lez-Binche
                </p>
                <a href="https://maps.google.com/?q=Rue+Joseph+Wauters+191,+7110+Péronnes-lez-Binche" target="_blank" rel="noopener noreferrer" class="flex justify-center w-full py-2.5 px-4 bg-white border border-stone-300 hover:bg-stone-50 text-stone-700 text-sm font-semibold rounded-xl transition-all duration-200">
                  Calculer l'itinéraire
                </a>
              </div>

            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>