---
import Layout from '../layouts/Layout.astro';
import { equipeData } from '../data/equipe';

// 1. Récupération de l'URL depuis le fichier .env
const googleScriptUrl = import.meta.env.GOOGLE_SCRIPT_URL;

// 2. Préparation des données pour le JavaScript côté client
const praticiensClient = Object.entries(equipeData)
  .filter(([_, data]) => data.actif)
  .map(([slug, data]) => {
    const imgSrc = typeof data.image === 'string' ? data.image : data.image?.src;
    return {
      slug,
      nom: data.nom,
      specialite: data.specialite,
      image: imgSrc
    };
  });
---

<Layout title="Contact & Rendez-vous | Centre Les Oranges" description="Prenez contact avec les praticiens du Centre Thérapeutique Les Oranges à Péronnes-lez-Binche.">
  <main class="pt-24 pb-16 bg-stone-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-5xl">
      
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold font-['Lora',serif] text-stone-900 mb-4">Contactez-nous</h1>
        <p class="text-stone-600 max-w-2xl mx-auto">
          Envoyez un message direct et sécurisé au secrétariat ou à votre praticien.
        </p>
      </div>

      <div class="grid md:grid-cols-12 gap-8 items-start">
        
        <!-- COLONNE GAUCHE : LA CARTE DYNAMIQUE DU DESTINATAIRE -->
        <div class="md:col-span-5 bg-white rounded-2xl shadow-sm border border-stone-200 p-6 sticky top-24 transition-all duration-300">
          <h2 class="text-sm font-bold uppercase tracking-wider text-amber-800 mb-6 pb-2 border-b border-stone-100">
            Votre destinataire
          </h2>

          <!-- État par défaut (Secrétariat) -->
          <div id="carte-secretariat" class="text-center py-4 block">
            <div class="w-24 h-24 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-amber-50">
              <svg class="w-10 h-10 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-stone-900">Secrétariat Général</h3>
            <p class="text-stone-500 text-sm mt-1">Centre Thérapeutique Les Oranges</p>
          </div>

          <!-- État Praticien (Rempli dynamiquement) -->
          <div id="carte-praticien" class="text-center py-4 hidden">
            <img id="photo-praticien" src="" alt="" class="w-24 h-24 object-cover rounded-full mx-auto mb-4 border-4 border-white shadow-md bg-stone-100" />
            <h3 id="nom-praticien" class="text-xl font-bold text-stone-900 font-['Lora',serif]"></h3>
            <p id="spe-praticien" class="text-amber-600 font-medium text-sm mt-1"></p>
            <div class="mt-4 inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full">
              <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span> Message direct
            </div>
          </div>
        </div>

        <!-- COLONNE DROITE : LE FORMULAIRE DE CONTACT -->
        <div class="md:col-span-7 bg-white rounded-2xl shadow-sm border border-stone-200 p-6 md:p-8">
          <form id="contact-form" class="space-y-5" onsubmit="envoyerMessage(event)">
            
            <!-- LE POT DE MIEL (ANTI-SPAM INVISIBLE) -->
            <div class="hidden" aria-hidden="true">
              <label for="website">Ne pas remplir ce champ si vous êtes humain</label>
              <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- SÉLECTEUR DE DESTINATAIRE -->
            <div>
              <label for="destinataire" class="block text-sm font-bold text-stone-700 mb-2">À qui s'adresse ce message ?</label>
              <select id="destinataire" name="destinataire" class="w-full border-stone-300 rounded-xl p-3 bg-stone-50 focus:bg-white focus:ring-2 focus:ring-amber-500 transition-colors">
                <option value="secretariat">Secrétariat / Informations générales</option>
                <optgroup label="Nos Praticiens">
                  {praticiensClient.map(p => (
                    <option value={p.slug}>{p.nom} - {p.specialite}</option>
                  ))}
                </optgroup>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="prenom" class="block text-sm font-bold text-stone-700 mb-2">Prénom</label>
                <input type="text" id="prenom" name="prenom" required class="w-full border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-amber-500" />
              </div>
              <div>
                <label for="nom" class="block text-sm font-bold text-stone-700 mb-2">Nom</label>
                <input type="text" id="nom" name="nom" required class="w-full border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-amber-500" />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-bold text-stone-700 mb-2">E-mail</label>
                <input type="email" id="email" name="email" required class="w-full border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-amber-500" />
              </div>
              <div>
                <label for="telephone" class="block text-sm font-bold text-stone-700 mb-2">Téléphone (Optionnel)</label>
                <input type="tel" id="telephone" name="telephone" class="w-full border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-amber-500" />
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-bold text-stone-700 mb-2">Votre message</label>
              <textarea id="message" name="message" rows="5" required class="w-full border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-amber-500 resize-none"></textarea>
            </div>

            <!-- BOUTON D'ENVOI -->
            <button type="submit" id="btn-submit" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-bold py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
              <span>Envoyer le message de manière sécurisée</span>
            </button>
            
            <!-- MESSAGE DE RETOUR (Succès/Erreur) -->
            <div id="form-status" class="hidden p-4 rounded-xl text-sm font-bold text-center mt-4"></div>
            
            <p class="text-xs text-stone-400 text-center mt-4">
              Ce formulaire est protégé contre le spam. Vos données ne sont transmises qu'au praticien concerné.
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>
</Layout>

<!-- 3. Injection des variables (dont googleScriptUrl) au script côté client -->
<script is:inline define:vars={{ praticiensClient, googleScriptUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    const selectDest = document.getElementById('destinataire');
    const carteSecretariat = document.getElementById('carte-secretariat');
    const cartePraticien = document.getElementById('carte-praticien');
    const imgElement = document.getElementById('photo-praticien');
    const nomElement = document.getElementById('nom-praticien');
    const speElement = document.getElementById('spe-praticien');

    function updateCarte(slug) {
      if (slug === 'secretariat') {
        cartePraticien.classList.add('hidden');
        carteSecretariat.classList.remove('hidden');
      } else {
        const praticien = praticiensClient.find(p => p.slug === slug);
        if (praticien) {
          imgElement.src = praticien.image || '/img/logo-cartoon.jpg';
          nomElement.textContent = praticien.nom;
          speElement.textContent = praticien.specialite;
          carteSecretariat.classList.add('hidden');
          cartePraticien.classList.remove('hidden');
        }
      }
    }

    const urlParams = new URLSearchParams(window.location.search);
    const destSlug = urlParams.get('dest');
    
    if (destSlug && praticiensClient.some(p => p.slug === destSlug)) {
      selectDest.value = destSlug;
    }
    
    updateCarte(selectDest.value);

    selectDest.addEventListener('change', (e) => {
      updateCarte(e.target.value);
    });
  });

  window.envoyerMessage = function(e) {
    e.preventDefault();
    
    const form = document.getElementById('contact-form');
    const btnSubmit = document.getElementById('btn-submit');
    const statusDiv = document.getElementById('form-status');
    const honeypot = document.getElementById('website').value;

    // Si pas d'URL Google Script configurée
    if (!googleScriptUrl) {
      statusDiv.textContent = "Erreur de configuration : Le système d'envoi n'est pas connecté.";
      statusDiv.className = "p-4 rounded-xl text-sm font-bold text-center mt-4 bg-red-50 text-red-700 block";
      return;
    }

    // ANTI-SPAM (Honeypot)
    if (honeypot !== "") {
      statusDiv.textContent = "Message envoyé avec succès.";
      statusDiv.className = "p-4 rounded-xl text-sm font-bold text-center mt-4 bg-emerald-50 text-emerald-700 block";
      return;
    }

    // UI: Mode chargement
    const originalBtnText = btnSubmit.innerHTML;
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `<svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Envoi en cours...`;

    // Envoi via fetch vers Google Apps Script
    const formData = new FormData(form);
    const params = new URLSearchParams(formData);

    fetch(googleScriptUrl, {
      method: 'POST',
      body: params
    })
    .then(response => response.json())
    .then(data => {
      if(data.result === 'success') {
        statusDiv.textContent = "Votre message a bien été envoyé au praticien !";
        statusDiv.className = "p-4 rounded-xl text-sm font-bold text-center mt-4 bg-emerald-50 text-emerald-700 block";
        btnSubmit.innerHTML = "Message envoyé ✓";
        form.reset();
      } else {
        throw new Error(data.message || "Erreur de transmission");
      }
    })
    .catch(error => {
      statusDiv.textContent = "Une erreur est survenue lors de l'envoi. Veuillez réessayer ou nous contacter par téléphone.";
      statusDiv.className = "p-4 rounded-xl text-sm font-bold text-center mt-4 bg-red-50 text-red-700 block";
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = originalBtnText;
    });
  }
</script>