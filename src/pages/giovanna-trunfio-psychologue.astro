---
import CollaborateurLayout from '../layouts/CollaborateurLayout.astro';
import { equipeData } from '../data/equipe';

// On récupère les infos de Giovanna depuis le fichier central
const praticien = equipeData["giovanna-trunfio"];
---

<CollaborateurLayout {...praticien}>
  
  <!-- Introduction -->
  <p class="text-lg leading-relaxed mb-6 font-medium text-gray-800">
    Psychologue clinicienne pour <strong>enfants, adolescents et adultes</strong>.
  </p>
  <p class="mb-10 text-gray-600">
    Quelles que soient les difficultés que vous rencontrez, je vous accompagne à votre rythme vers la solution qui sommeille en vous.
  </p>

  <!-- Problématiques prises en charge -->
  <div class="mb-10">
    <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-3">
      <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
      Problématiques prises en charge
    </h3>
    
    <p class="mb-4 text-gray-600">Suite à un long parcours dans des contextes professionnels variés, je me définis comme "généraliste" et peux voir des personnes pour des problématiques diverses telles que :</p>

    <div class="grid sm:grid-cols-2 gap-3">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-start gap-3">
        <span class="w-2 h-2 mt-2 bg-orange-500 rounded-full shrink-0"></span>
        <span class="text-gray-700">Anxiété, dépression, burnout</span>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-start gap-3">
        <span class="w-2 h-2 mt-2 bg-orange-500 rounded-full shrink-0"></span>
        <span class="text-gray-700">Stress post-traumatique</span>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-start gap-3">
        <span class="w-2 h-2 mt-2 bg-orange-500 rounded-full shrink-0"></span>
        <span class="text-gray-700">Handicap</span>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-start gap-3">
        <span class="w-2 h-2 mt-2 bg-orange-500 rounded-full shrink-0"></span>
        <span class="text-gray-700">Problématiques psychiatriques</span>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-start gap-3">
        <span class="w-2 h-2 mt-2 bg-orange-500 rounded-full shrink-0"></span>
        <span class="text-gray-700">Réinsertion socio-professionnelle</span>
      </div>
    </div>
  </div>

  <!-- Outils utilisés -->
  <div class="bg-orange-50 rounded-2xl p-8 border border-orange-100 mb-10">
    <h3 class="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-3">
      <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      Outils utilisés
    </h3>
    <p class="mb-6 text-gray-700">Les outils thérapeutiques que j’utilise sont avant tout centrés sur la personne, ses ressources et ses besoins. Suite à de nombreuses formations, je propose, entre autres :</p>
    
    <ul class="space-y-3 text-gray-700">
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span><strong>Techniques de thérapie brève orientée solutions</strong></span>
      </li>
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span><strong>EMDR</strong> (psychotrauma)</span>
      </li>
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span><strong>Exposition prolongée</strong> (psychotrauma)</span>
      </li>
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span><strong>Sophrologie</strong></span>
      </li>
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span><strong>Art-thérapie :</strong> Accompagnement basé sur l’utilisation d’un média artistique (peinture, dessin, collage, …) variable selon la situation, l’objectif et/ou les attraits personnels.</span>
      </li>
    </ul>
  </div>

</CollaborateurLayout>