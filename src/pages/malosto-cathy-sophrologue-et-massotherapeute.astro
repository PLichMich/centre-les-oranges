---
import CollaborateurLayout from '../layouts/CollaborateurLayout.astro';
import { equipeData } from '../data/equipe';

// On récupère les infos de Cathy depuis le fichier central
const praticien = equipeData["cathy-malosto"];
---

<CollaborateurLayout {...praticien}>
  
  <!-- Introduction -->
  <p class="text-lg leading-relaxed mb-6 font-medium text-gray-800">
    Sophrologue et massothérapeute.
  </p>
  <p class="mb-10 text-gray-600">
    Vous souhaitez apprendre à vous relaxer et à lâcher prise ? Je vous reçois pour des consultations individuelles ou familiales ainsi que lors d'ateliers de groupe au Centre Thérapeutique Les Oranges.
  </p>

  <!-- Spécialités -->
  <div class="mb-10">
    <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-3">
      <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
      Mes spécialités
    </h3>
    
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
        <h4 class="font-bold text-gray-800 mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Sophrologie
        </h4>
        <p class="text-gray-600 text-sm">Pour enfants dès 5 ans, adolescents, adultes et femmes enceintes (préparation à la naissance).</p>
      </div>

      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
        <h4 class="font-bold text-gray-800 mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Massages assis & Reiki
        </h4>
        <p class="text-gray-600 text-sm">Massages assis habillés (Amma) pour ados et adultes, ainsi que des séances de reiki.</p>
      </div>

      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
        <h4 class="font-bold text-gray-800 mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Massages parents/enfants
        </h4>
        <p class="text-gray-600 text-sm">Apprentissage des protocoles de massage (MISP) en famille pour apaiser les tensions et se détendre.</p>
      </div>

      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
        <h4 class="font-bold text-gray-800 mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Remédiations scolaires
        </h4>
        <p class="text-gray-600 text-sm">Accompagnement ciblé pour les élèves du primaire, fort de mon expérience d'ancienne institutrice.</p>
      </div>
    </div>
  </div>

  <!-- Problématiques prises en charge -->
  <div class="mb-10">
    <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-3">
      <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
      Problématiques accompagnées
    </h3>
    
    <ul class="grid sm:grid-cols-2 gap-y-3 gap-x-6 text-gray-700 text-sm">
      <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 mt-1.5 bg-orange-500 rounded-full shrink-0"></span> Stress et anxiété, nervosité et impulsions</li>
      <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 mt-1.5 bg-orange-500 rounded-full shrink-0"></span> Troubles de l'attention (TDAH)</li>
      <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 mt-1.5 bg-orange-500 rounded-full shrink-0"></span> Gestion de la douleur chronique et fatigue</li>
      <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 mt-1.5 bg-orange-500 rounded-full shrink-0"></span> Accompagnement du burn-out et du deuil</li>
      <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 mt-1.5 bg-orange-500 rounded-full shrink-0"></span> Confiance en soi et troubles du sommeil</li>
    </ul>
  </div>

  <!-- Ateliers de groupe -->
  <div class="bg-orange-50 rounded-2xl p-8 border border-orange-100">
    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-3">
      <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      Ateliers de groupe proposés
    </h3>
    <ul class="space-y-3 text-sm text-gray-700">
      <li class="flex items-start gap-2"><span class="font-bold text-orange-500">✔</span> Gestion du stress et de l'anxiété (en collaboration avec Aurélie Holvoet)</li>
      <li class="flex items-start gap-2"><span class="font-bold text-orange-500">✔</span> Gestion du stress et des douleurs par la sophrologie (pour ados et adultes)</li>
      <li class="flex items-start gap-2"><span class="font-bold text-orange-500">✔</span> Préparation à l'accouchement par la sophrologie pour les futurs parents</li>
      <li class="flex items-start gap-2"><span class="font-bold text-orange-500">✔</span> Ateliers découverte de massages parents/enfants (MISA)</li>
    </ul>
  </div>

</CollaborateurLayout>