---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import equipe from '../data/equipe.json';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/equipe/*.{jpeg,jpg,png,webp}');
const equipeTriee = equipe.sort((a, b) => a.nom.localeCompare(b.nom));
---

<Layout 
  title="Annuaire des Thérapeutes | Centre Les Oranges"
  description="Trouvez le bon spécialiste et prenez rendez-vous au Centre Thérapeutique Les Oranges à Péronnes-lez-Binche."
>

  <div class="bg-slate-50 min-h-screen pb-24">
    
    <!-- EN-TÊTE -->
    <section class="bg-white py-12 md:py-16 border-b border-slate-200 mb-8 md:mb-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="font-['Lora',serif] text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Annuaire de nos praticiens
        </h1>
        <p class="text-slate-600 font-light">
          Sélectionnez la spécialité recherchée pour trouver le thérapeute adapté.
        </p>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- BARRE DE FILTRES -->
      <div class="flex flex-wrap justify-center gap-2 mb-10 border-b border-slate-200 pb-6">
        <button class="filter-btn active px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-slate-900 text-white" data-filter="all">Tous</button>
        <button class="filter-btn px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="psy">Psychologie</button>
        <button class="filter-btn px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="paramedical">Paramédical</button>
        <button class="filter-btn px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="bienetre">Bien-être & Nutrition</button>
      </div>

      <!-- LISTE DES PRATICIENS -->
      <div class="space-y-4" id="directory-grid">
        
        {equipeTriee.map((pro) => (
          <div 
            class={`pro-card bg-white rounded-xl border border-slate-200 p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-6 shadow-sm transition-all relative ${pro.statut === 'absent' ? 'opacity-80' : 'hover:shadow-md hover:border-orange-300 group'}`} 
            data-category={pro.categorie}
          >
            
            {/* LE LIEN INVISIBLE QUI COUVRE TOUTE LA CARTE */}
            <a href={pro.link} class="absolute inset-0 z-0" aria-label={`Voir la fiche de ${pro.nom}`}></a>
            
            <!-- Badge "Absent" -->
            {pro.statut === 'absent' && (
              <span class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/3 bg-amber-100 border border-amber-200 text-amber-800 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-widest z-10 hidden sm:block">
                Absent
              </span>
            )}

            <!-- Photo -->
            <div class="flex-shrink-0 relative pointer-events-none">
              {pro.statut === 'absent' && (
                <span class="absolute -top-2 -right-2 bg-amber-100 border border-amber-200 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-widest z-10 sm:hidden">
                  Absent
                </span>
              )}
              
              {images[`/src/assets/equipe/${pro.photo}`] ? (
                <Image 
                  src={images[`/src/assets/equipe/${pro.photo}`]()} 
                  alt={pro.nom}
                  width={150} 
                  height={150}
                  class={`w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-lg border border-slate-100 shadow-sm transition-transform duration-300 group-hover:scale-105 ${pro.statut === 'absent' ? 'grayscale opacity-60' : ''}`}
                />
              ) : (
                <div class="w-16 h-16 sm:w-20 sm:h-20 bg-slate-100 rounded-lg flex items-center justify-center text-[10px] text-slate-400 border border-slate-200">
                  Pas de photo
                </div>
              )}
            </div>

            <!-- Informations -->
            <div class="flex-grow pointer-events-none">
              <h2 class={`text-sm font-bold uppercase tracking-widest mb-1 transition-colors ${pro.statut === 'absent' ? 'text-slate-500' : 'text-orange-700 group-hover:text-orange-800'}`}>
                {pro.metier}
              </h2>
              <h3 class={`font-['Lora',serif] text-xl font-bold mb-2 ${pro.statut === 'absent' ? 'text-slate-600' : 'text-slate-900'}`}>
                {pro.nom}
              </h3>
              
              <div class="flex flex-wrap gap-2 mt-3 relative z-10">
                {pro.tags.map((tag: string) => (
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium ${pro.statut === 'absent' ? 'bg-slate-50 text-slate-400 border border-slate-100' : 'bg-slate-100 text-slate-600'}`}>
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Boutons / Zone d'action -->
            <div class="w-full sm:w-auto flex flex-col sm:items-end gap-2 border-t sm:border-t-0 sm:border-l border-slate-100 pt-4 sm:pt-0 sm:pl-6 mt-2 sm:mt-0 relative z-10">
              
              {pro.statut !== 'absent' ? (
                <>
                  <a href="/prendre-rendez-vous" class="w-full sm:w-40 text-center py-2.5 px-4 text-sm font-bold text-white bg-slate-900 hover:bg-orange-800 rounded-lg transition-colors">
                    Prendre RDV
                  </a>
                  <a href={pro.link} class="w-full sm:w-40 text-center py-2.5 px-4 text-sm font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-lg transition-colors group-hover:bg-orange-50 group-hover:border-orange-200 group-hover:text-orange-800">
                    Voir la fiche
                  </a>
                </>
              ) : (
                <>
                  <p class="text-xs font-medium text-amber-700 w-full sm:w-40 text-center mb-1">
                    {pro.message_statut}
                  </p>
                  
                  {pro.redirection_url ? (
                    <a href={pro.redirection_url} class="w-full sm:w-40 text-center py-2.5 px-4 text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg transition-colors">
                      {pro.redirection_texte || "Voir l'équipe"}
                    </a>
                  ) : (
                    <span class="w-full sm:w-40 text-center py-2.5 px-4 text-sm font-bold text-slate-400 bg-slate-50 border border-slate-100 rounded-lg cursor-not-allowed">
                      Indisponible
                    </span>
                  )}
                  <a href={pro.link} class="w-full sm:w-40 text-center py-1.5 px-4 text-xs font-medium text-slate-500 bg-white hover:text-slate-700 transition-colors">
                    Fiche archivée
                  </a>
                </>
              )}
            </div>

          </div>
        ))}

      </div>
      
      <!-- Message aucun résultat -->
      <div id="no-results" class="hidden text-center py-12 bg-white rounded-xl border border-dashed border-slate-300 mt-4">
        <p class="text-slate-500 font-medium">Aucun spécialiste trouvé dans cette catégorie.</p>
      </div>

    </div>
  </div>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.pro-card');
    const noResults = document.getElementById('no-results');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.classList.add('bg-slate-900', 'text-white');

        const filterValue = btn.getAttribute('data-filter');
        let visibleCount = 0;

        cards.forEach(card => {
          if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    });
  });
</script>