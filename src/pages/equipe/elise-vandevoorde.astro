---
import CollaborateurLayout from '../../layouts/CollaborateurLayout.astro';
import { equipeData } from '../../data/equipe';

const membre = equipeData['elise-vandevoorde'];
---

<CollaborateurLayout {...membre}>
  <div class="space-y-6 text-stone-700 leading-relaxed text-base">
    
    <!-- Section Présentation -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200/80">
      <h2 class="text-xl sm:text-2xl font-bold font-['Lora',serif] text-stone-900 mb-4 pb-2 border-b-2 border-amber-500 flex items-center gap-2">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Présentation
      </h2>
      <div class="space-y-4 text-stone-600">
        <p>
          Psychomotricienne diplômée, Elise Vandevoorde vous accueille au Centre Thérapeutique Les Oranges pour accompagner les nourrissons, les enfants, les adolescents ainsi que les adultes à travers une approche globale alliant le corps, le mouvement et la vie affective.
        </p>
        <p>
          Par le biais du jeu, de l'expression corporelle et d'exercices ciblés, la prise en charge psychomotrice aide chacun à mieux habiter son corps, à réguler ses émotions et à développer harmonieusement ses compétences motrices et relationnelles.
        </p>
      </div>
    </section>

    <!-- Section Domaines d'accompagnement -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200/80">
      <h2 class="text-xl sm:text-2xl font-bold font-['Lora',serif] text-stone-900 mb-6 pb-2 border-b-2 border-amber-500 flex items-center gap-2">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        Domaines d'accompagnement
      </h2>

      <div class="space-y-6">
        <div>
          <h3 class="text-base font-bold text-amber-900 mb-3 bg-amber-50/60 p-3 rounded-xl border border-amber-200/60">
            Chez l'enfant et le jeune :
          </h3>
          <ul class="space-y-2.5 pl-2 text-stone-600">
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong class="text-stone-800">Développement psychomoteur :</strong> retards de développement moteur global, équilibre, coordination et éveil sensori-moteur.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong class="text-stone-800">Apprentissages scolaires :</strong> motricité fine, graphomotricité (tenue de l'outil scripteur, geste graphique), repérage spatio-temporel et latéralité.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong class="text-stone-800">Sphère émotionnelle et relationnelle :</strong> agitation psychomotrice, difficultés d'attention, inhibition, gestion des émotions et confiance en soi.</span>
            </li>
          </ul>
        </div>

        <div class="pt-2">
          <h3 class="text-base font-bold text-amber-900 mb-3 bg-amber-50/60 p-3 rounded-xl border border-amber-200/60">
            Chez l'adolescent et l'adulte :
          </h3>
          <ul class="space-y-2.5 pl-2 text-stone-600">
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong class="text-stone-800">Conscience corporelle :</strong> réappropriation du schéma corporel, détente tonico-émotionnelle et apaisement des tensions liées au stress ou à l'anxiété.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</CollaborateurLayout>