---
import CollaborateurLayout from '../../layouts/CollaborateurLayout.astro';
import { equipeData } from '../../data/equipe';

const praticien = equipeData["aurelie-holvoet"];
---

<CollaborateurLayout {...praticien}>
  <div class="space-y-6 text-stone-700 leading-relaxed text-base">
    
    <!-- Section Présentation -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200/80">
      <h2 class="text-xl sm:text-2xl font-bold font-['Lora',serif] text-stone-900 mb-4 pb-2 border-b-2 border-amber-500 flex items-center gap-2">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Présentation
      </h2>
      <div class="space-y-4 text-stone-600">
        <p>
          Psychologue clinicienne conventionnée (première ligne et soins spécialisés), Aurélie Holvoet vous reçoit au Centre Thérapeutique Les Oranges pour des consultations et des ateliers dédiés aux enfants (dès 10 ans), adolescents, adultes et familles.
        </p>
        <p>
          Sa pratique s'articule principalement autour de la <strong>thérapie brève orientée solutions</strong> et de l'<strong>écriture thérapeutique</strong>, une approche concrète et respectueuse qui vise à mobiliser rapidement vos propres ressources pour surmonter les difficultés du quotidien.
        </p>
      </div>
    </section>

    <!-- Section Domaines d'accompagnement -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200/80">
      <h2 class="text-xl sm:text-2xl font-bold font-['Lora',serif] text-stone-900 mb-6 pb-2 border-b-2 border-amber-500 flex items-center gap-2">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2m-6 9l2 2 4-4"></path>
        </svg>
        Domaines d'accompagnement
      </h2>

      <div class="space-y-6">
        <div>
          <h3 class="text-base font-bold text-amber-900 mb-3 bg-amber-50/60 p-3 rounded-xl border border-amber-200/60">
            Pour les enfants (dès 10 ans), adolescents et familles :
          </h3>
          <ul class="space-y-2.5 pl-2">
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Gestion des émotions :</strong> peurs, crises de colère, tristesse, deuils, repli sur soi et relations amicales ou amoureuses.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Soutien et orientation :</strong> gestion du stress, confiance en soi, troubles du sommeil et harcèlement scolaire.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Guidance parentale :</strong> écoute et soutien aux parents et futurs parents.</span>
            </li>
          </ul>
        </div>

        <div class="pt-2">
          <h3 class="text-base font-bold text-amber-900 mb-3 bg-amber-50/60 p-3 rounded-xl border border-amber-200/60">
            Pour les adultes :
          </h3>
          <ul class="space-y-2.5 pl-2">
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Soutien psychologique :</strong> gestion du stress, anxiété, phobies et états dépressifs.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Sphère professionnelle :</strong> difficultés au travail et prévention du burnout.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 font-bold mt-0.5">•</span>
              <span><strong>Équilibre de vie :</strong> troubles du sommeil sans cause organique et gestion émotionnelle de l'alimentation.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section Ateliers de groupe -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200/80">
      <h2 class="text-xl sm:text-2xl font-bold font-['Lora',serif] text-stone-900 mb-4 pb-2 border-b-2 border-amber-500 flex items-center gap-2">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        Ateliers de groupe
      </h2>
      <p class="text-stone-600 leading-relaxed">
        Aurélie co-anime également des cycles d'ateliers thématiques au centre, notamment axés sur la gestion du stress et des émotions (en collaboration avec Cathy Malosto) ainsi que sur la prévention de la dépression saisonnière et la psychologie positive (avec Valérie Desclez).
      </p>
    </section>

  </div>
</CollaborateurLayout>