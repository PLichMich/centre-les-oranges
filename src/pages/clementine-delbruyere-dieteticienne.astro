---
import LayoutPraticien from '../layouts/LayoutPraticien.astro';
import equipe from '../data/equipe.json';

const praticienData = equipe.find(pro => pro.id === 'clementine-delbruyere');
---

<LayoutPraticien praticienData={praticienData}>
  
  <!-- TOUT CE QUI EST ICI SERA INJECTÉ DANS LE <slot /> DU GABARIT -->

  <!-- Section Présentation -->
  <section>
    <h2 class="font-['Lora',serif] text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
      <span class="w-8 h-px bg-orange-700"></span> Présentation
    </h2>
    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm text-slate-600 leading-relaxed space-y-4 font-light text-lg">
      <p>Diplômée en diététique, je vous accompagne dans votre démarche nutritionnelle...</p>
    </div>
  </section>

  <!-- Section Spécialités & Diplômes -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
    <section>
      <h2 class="font-['Lora',serif] text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
        <span class="w-6 h-px bg-orange-700"></span> Expertises
      </h2>
      <ul class="space-y-3">
        <li class="flex items-center gap-3 text-slate-700 bg-white px-4 py-3 rounded-xl border border-slate-200">
          Rééquilibrage alimentaire
        </li>
      </ul>
    </section>

    <section>
      <h2 class="font-['Lora',serif] text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
        <span class="w-6 h-px bg-orange-700"></span> Diplômes
      </h2>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 space-y-4">
        <div>
          <h4 class="font-bold text-slate-900">Bachelier en Diététique</h4>
          <p class="text-sm text-slate-500">Haute École Provinciale de Hainaut - Condorcet</p>
        </div>
      </div>
    </section>
  </div>

</LayoutPraticien>