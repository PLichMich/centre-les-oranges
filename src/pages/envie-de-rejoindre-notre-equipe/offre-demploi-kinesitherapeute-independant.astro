---
// src/pages/envie-de-rejoindre-notre-equipe/offre-demploi-kinesitherapeute-independant.astro
import JobOfferLayout from '../../layouts/JobOfferLayout.astro';
---

<JobOfferLayout 
  titre="Recherche Kinésithérapeute Indépendant(e)"
  profession="Kinésithérapeute"
  descriptionCourte="Le Centre Thérapeutique Les Oranges recrute un(e) kinésithérapeute indépendant(e) pour rejoindre son équipe pluridisciplinaire entre Binche et La Louvière. Cabinet équipé, début rapide possible."
  urgent={true}
>

  <p class="text-xl font-medium text-gray-800 mb-8 border-l-4 border-orange-500 pl-4">
    Idéalement situé à Péronnes-lez-Binche (entre Binche et La Louvière), le <strong>Centre Thérapeutique Les Oranges</strong> recherche activement un(e) <strong>kinésithérapeute sous statut indépendant</strong> pour répondre à une forte demande locale de soins en rééducation et en santé globale[cite: 1].
  </p>

  <p class="text-gray-700 leading-relaxed mb-8">
    Que vous soyez fraîchement diplômé(e) ou praticien(ne) expérimenté(e), notre cadre favorise l'échange direct avec d'autres professionnels de santé (ostéopathe, ergothérapeute, podologues, psychomotricienne, psychologues) au sein d'un environnement stimulant et bienveillant[cite: 1].
  </p>

  <h3 class="text-2xl font-bold text-gray-800 mt-10 mb-4">🎯 Vos Missions</h3>
  <ul class="space-y-2 mb-8">
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Prise en charge des consultations de kinésithérapie générale et de rééducation fonctionnelle[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Déploiement éventuel de vos spécialisations (kiné périnatale/pédiatrique, kiné du sport, rééducation posturale, etc.)</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Synergie et orientation croisée des patients avec l'équipe pluridisciplinaire du centre[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Possibilité d'animer des cours collectifs (école du dos, gym douce, mobilité) dans notre grande salle d'ateliers[cite: 1]</li>
  </ul>

  <h3 class="text-2xl font-bold text-gray-800 mt-10 mb-4">📋 Profil recherché</h3>
  <ul class="space-y-2 mb-8">
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> <strong>Master ou diplôme en kinésithérapie</strong> reconnu en Belgique (numéro INAMI en ordre)</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> <strong>Statut indépendant</strong> (à titre principal ou complémentaire)[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Motivation, rigueur déontologique et sens de la collaboration[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> Esprit d'initiative et ouverture aux approches thérapeutiques complémentaires[cite: 1]</li>
  </ul>

  <div class="bg-orange-50 rounded-2xl p-6 border border-orange-100 my-10">
    <h3 class="text-xl font-bold text-gray-800 mb-4">🏢 Ce que nous offrons</h3>
    <ul class="grid sm:grid-cols-2 gap-4">
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">📍</span> Cabinet professionnel meublé et prêt à l'emploi[cite: 1]</li>
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">🏋️</span> Accès à une grande salle pour rééducation active et ateliers[cite: 1]</li>
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">☕</span> Salles d'attente partagées et cuisine réservée aux thérapeutes[cite: 1]</li>
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">🚗</span> Parking facile pour les patients et les praticiens[cite: 1]</li>
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">🌿</span> Cadre agréable et espace extérieur (jardin)[cite: 1]</li>
      <li class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm"><span class="text-2xl">🌐</span> Référencement de votre profil sur le site web du centre[cite: 1]</li>
    </ul>
  </div>

  <h3 class="text-2xl font-bold text-gray-800 mt-10 mb-4">⏰ Modalités et Conditions</h3>
  <ul class="space-y-2 mb-8">
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> <strong>Début :</strong> Dès que possible (demande soutenue de suivi de patients)[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> <strong>Volume horaire :</strong> Flexible, selon vos disponibilités et les plages horaires convenues[cite: 1]</li>
    <li class="flex items-center gap-2"><span class="text-orange-500">✔</span> <strong>Tarifs de mise à disposition :</strong> Formules concurrentielles et dégressives selon le volume de plages louées[cite: 1]</li>
  </ul>

</JobOfferLayout>