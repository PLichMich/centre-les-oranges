---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';

// On définit les propriétés que chaque offre d'emploi devra fournir
const { 
  titre, 
  profession, 
  descriptionCourte, 
  datePublication = new Date().toISOString().split('T')[0],
  salaireMin = "25",
  salaireMax = "30",
  urgent = false
} = Astro.props;

// Génération automatique des données structurées pour Google Jobs !
const jobPostingJsonLd = {
  "@context": "https://schema.org/",
  "@type": "JobPosting",
  "title": profession,
  "description": descriptionCourte,
  "datePosted": datePublication,
  "employmentType": ["CONTRACTOR", "PART_TIME", "FULL_TIME"],
  "hiringOrganization": {
    "@type": "Organization",
    "name": "Centre Thérapeutique Les Oranges",
    "sameAs": "https://www.centrelesoranges.be",
    "logo": "https://www.centrelesoranges.be/images/logo.png"
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue Joseph Wauters 191",
      "addressLocality": "Péronnes-lez-Binche",
      "postalCode": "7134",
      "addressCountry": "BE"
    }
  },
  "jobLocationType": "TELECOMMUTE",
  "applicantLocationRequirements": {
    "@type": "Country",
    "name": "Belgium"
  },
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "EUR",
    "value": {
      "@type": "QuantitativeValue",
      "minValue": salaireMin,
      "maxValue": salaireMax,
      "unitText": "HOUR"
    }
  }
};
---

<Layout title={`${titre} | Recrutement Binche`} description={descriptionCourte}>
  
  <!-- Injection du SEO caché pour Google Jobs -->
  <script type="application/ld+json" set:html={JSON.stringify(jobPostingJsonLd)} />

  <main class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-4xl">
      
      <!-- En-tête de l'offre -->
      <div class="bg-white rounded-3xl shadow-sm p-8 md:p-12 mb-8 border border-gray-100 text-center relative overflow-hidden">
        
        {urgent && (
          <div class="absolute top-0 right-0 bg-red-500 text-white text-xs font-bold px-12 py-2 rotate-45 translate-x-10 mt-6 shadow-md uppercase tracking-wider">
            Urgent
          </div>
        )}

        <span class="inline-block px-4 py-1.5 bg-orange-100 text-orange-700 text-sm font-bold rounded-full mb-4 uppercase tracking-wider">
          Offre de collaboration
        </span>
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 font-heading mb-4">
          {titre}
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Rejoignez notre équipe pluridisciplinaire dans un cadre exceptionnel à Péronnes-lez-Binche !
        </p>

        <!-- Gros bouton d'action primaire -->
        <div class="mt-8">
          <a href="mailto:info@centrelesoranges.be?subject=Candidature%20%3A%20{profession}" class="inline-flex items-center gap-2 bg-orange-500 text-white font-bold text-lg py-4 px-8 rounded-full hover:bg-orange-600 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-1">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            Postuler par e-mail
          </a>
        </div>
      </div>

      <!-- Contenu injecté (La description du poste) -->
      <div class="bg-white rounded-3xl shadow-sm p-8 md:p-12 border border-gray-100 prose prose-lg prose-orange max-w-none">
        <slot />
      </div>

      <!-- Footer de l'offre commun à tous les recrutements -->
      <div class="mt-12 bg-gray-800 rounded-3xl p-8 text-center text-white">
        <h3 class="text-xl font-bold mb-4">Comment postuler ?</h3>
        <p class="text-gray-400 mb-6">Envoyez-nous simplement un e-mail avec :</p>
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <span class="bg-gray-700 px-4 py-2 rounded-lg text-sm font-medium">📄 CV actualisé</span>
          <span class="bg-gray-700 px-4 py-2 rounded-lg text-sm font-medium">✍️ Lettre de motivation</span>
          <span class="bg-gray-700 px-4 py-2 rounded-lg text-sm font-medium">🎓 Copie du diplôme</span>
        </div>
        <p class="text-sm text-gray-500">Pour toute question : <a href="mailto:info@centrelesoranges.be" class="text-orange-400 hover:text-orange-300">info@centrelesoranges.be</a></p>
      </div>

    </div>
  </main>
</Layout>