---
// LA LIGNE MAGIQUE QUI RAMÈNE LE DESIGN
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string; // On autorise le Layout à recevoir une image
}

// On récupère les infos. Si aucune image n'est fournie, on met le logo par défaut.
const { 
  title, 
  description, 
  image = '/img/logo-cartoon.jpg' 
} = Astro.props;

// Facebook et WhatsApp exigent une URL complète (absolue). 
// Astro.url permet de générer ça automatiquement en fonction du lien actuel.
const socialImageURL = new URL(image, Astro.url);
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- NOUVEAU : Balises Open Graph pour les réseaux sociaux -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImageURL} />

    <!-- POLICES GOOGLE FONTS ... la suite de ton head ... -->
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 text-stone-800 antialiased font-['Inter',sans-serif]">
    
    <!-- Notre nouveau composant Header -->
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Pied de page provisoire -->
    <Footer />

  </body>
</html>