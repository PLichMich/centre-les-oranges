---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import { equipeData } from '../data/equipe';

// Permet de gérer aussi bien le Markdown (frontmatter) que le .astro direct
const props = Astro.props.frontmatter || Astro.props;
const titreService = props.titreService || props.title;
const sousTitre = props.sousTitre;

// Récupération des praticiens depuis equipe.ts
let praticiensList = [];
if (props.praticiens && Array.isArray(props.praticiens)) {
  praticiensList = props.praticiens.map((id: string) => equipeData[id]).filter(Boolean);
} else if (props.praticienId && equipeData[props.praticienId]) {
  praticiensList = [equipeData[props.praticienId]];
}
---

<Layout title={props.title} description={props.description}>
  
  <!-- BANDEROLE AU-DESSUS : Plus fine, alignée à gauche, foncé vers clair -->
  <div class="bg-gradient-to-r from-orange-700 to-amber-400 py-8 md:py-10 mb-12 shadow-sm border-b border-orange-800/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-2 drop-shadow-sm">{titreService}</h1>
      {sousTitre && <p class="text-lg md:text-xl text-orange-50 font-semibold drop-shadow-sm">{sousTitre}</p>}
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- CONTENU PRINCIPAL (Markdown) -->
      <div class="lg:col-span-8">
        <article class="prose prose-stone max-w-none">
          <slot />
        </article>
      </div>

      <!-- SUR LE CÔTÉ (Sidebar) -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Fiche Praticien (Photo + Lien) -->
        {praticiensList.length > 0 && praticiensList.map((p) => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm text-center">
            {p.image ? (
              <Image 
                src={p.image} 
                alt={`Portrait de ${p.nom}`} 
                width={128} 
                height={128} 
                class="w-32 h-32 mx-auto rounded-full object-cover border-4 border-stone-50 shadow-sm mb-4" 
              />
            ) : (
              <div class="w-32 h-32 mx-auto rounded-full bg-stone-100 flex items-center justify-center text-stone-400 font-bold text-3xl mb-4 border-4 border-stone-50 shadow-sm">
                {p.nom.charAt(0)}
              </div>
            )}
            <h3 class="text-xl font-bold text-stone-900">{p.nom}</h3>
            <p class="text-stone-600 font-medium mb-4">{p.specialite}</p>
            
            {p.telephone && (
              <a href={`tel:${p.telephone.replace(/[^0-9+]/g, '')}`} class="block w-full bg-amber-500 text-stone-900 font-bold px-4 py-3 rounded-xl hover:bg-amber-400 transition-colors mb-3 shadow-sm">
                📞 {p.telephone}
              </a>
            )}
            {p.lien && (
              <a href={p.lien} class="inline-block text-sm font-semibold text-amber-700 hover:text-amber-600 hover:underline transition-colors mt-1">
                Voir le profil complet &rarr;
              </a>
            )}
          </div>
        ))}

        <!-- Image Google Maps -->
        <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm text-center">
          <h4 class="font-bold text-stone-900 mb-4 text-lg">📍 Nous trouver</h4>
          <div class="aspect-square w-full rounded-xl overflow-hidden mb-4 bg-stone-100 border border-stone-200">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2537.4937213233177!2d4.148113!3d50.437937!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c235b2e584fbf3%3A0xc3f1dc2eb3a84175!2sRue%20Joseph%20Wauters%20191%2C%207110%20Binche!5e0!3m2!1sfr!2sbe!4v1700000000000!5m2!1sfr!2sbe" 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
          </div>
          <p class="text-sm text-stone-600 leading-relaxed">
            <strong>Centre Thérapeutique Les Oranges</strong><br/>
            Rue Joseph Wauters 191<br/>
            7110 Péronnes-lez-Binche
          </p>
        </div>

      </aside>
    </div>
  </main>
</Layout>