---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';

// On utilise tes clés existantes !
const { 
  nom, 
  specialite, // <-- Adapté à ton equipe.ts
  image, 
  telephone, 
  conventionne = false, 
  actif = true, 
  lien = "/nos-services" // <-- Adapté à ton equipe.ts
} = Astro.props;
---

<Layout title={`${nom} | ${specialite} à Binche`} description={`${specialite} au Centre Thérapeutique Les Oranges à Péronnes-lez-Binche.`}>
  <main class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-4xl">
      
      <!-- En-tête du profil -->
      <div class="bg-white rounded-2xl shadow-sm p-8 mb-8 border border-gray-100 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">
        
        <!-- Ruban "Ancien Collaborateur" si inactif -->
        {!actif && (
          <div class="absolute top-0 right-0 bg-gray-200 text-gray-600 text-xs font-bold px-12 py-2 rotate-45 translate-x-8 mt-4 shadow-sm border-y border-gray-300">
            INACTIF
          </div>
        )}

        <div class={`w-32 h-32 rounded-full flex items-center justify-center shrink-0 overflow-hidden border-4 shadow-md ${actif ? 'border-white bg-orange-50' : 'border-gray-200 bg-gray-100 grayscale opacity-70'}`}>
          {image ? (
            <Image src={image} alt={nom} class="w-full h-full object-cover" />
          ) : (
            <svg class={`w-16 h-16 ${actif ? 'text-orange-500' : 'text-gray-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          )}
        </div>
        
        <div class="text-center md:text-left flex-1">
          <div class="flex flex-col md:flex-row md:items-center gap-3 mb-2">
            <h1 class={`text-3xl font-bold font-heading ${actif ? 'text-gray-800' : 'text-gray-500 line-through decoration-gray-300'}`}>
              {nom}
            </h1>
            
            <!-- Nouveau Badge Premium "Première Ligne" -->
            {conventionne && actif && (
              <span class="inline-flex items-center px-3 py-1 bg-gradient-to-r from-emerald-500 to-green-600 text-white text-xs font-bold rounded-full shadow-sm">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                Conventionné 1ère ligne
              </span>
            )}
          </div>
          <h2 class={`text-xl font-medium mb-4 ${actif ? 'text-orange-500' : 'text-gray-400'}`}>{specialite}</h2>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Zone de contenu central (Les textes, bilans, etc. s'injectent ici via le slot) -->
        <div class="md:col-span-2">
          {actif ? (
            <slot />
          ) : (
            <div class="bg-gray-50 rounded-2xl p-8 border-2 border-gray-200 text-center">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <h3 class="text-xl font-bold text-gray-700 mb-2">Fin de collaboration</h3>
              <p class="text-gray-500 mb-6">{nom} ne consulte plus actuellement au Centre Thérapeutique Les Oranges.</p>
              <a href={lien} class="inline-block bg-white text-gray-700 font-semibold py-2 px-6 rounded-lg border border-gray-300 hover:bg-gray-100 transition-colors">
                Découvrir notre équipe actuelle
              </a>
            </div>
          )}
        </div>

        <!-- Colonne de droite : La carte de contact (Affichée uniquement si actif) -->
        <div class="md:col-span-1">
          {actif && (
            <div class="bg-white p-6 rounded-2xl shadow-sm border-2 border-orange-100 sticky top-24">
              <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                Prendre rendez-vous
              </h3>
              {telephone ? (
                <a href={`tel:${telephone.replace(/\D/g,'')}`} class="block text-2xl font-bold text-orange-500 hover:text-orange-600 transition-colors mb-2">
                  {telephone}
                </a>
              ) : (
                <p class="text-gray-600 font-medium mb-2">Contact via le secrétariat</p>
              )}
              <p class="text-gray-500 text-xs mb-6">N'hésitez pas à laisser un message vocal si nécessaire.</p>
              <a href="/contact" class="block text-center w-full bg-orange-500 text-white font-semibold py-3 px-4 rounded-lg hover:bg-orange-600 transition-colors shadow-sm">
                Voir l'accès au centre
              </a>
            </div>
          )}
        </div>
      </div>

    </div>
  </main>
</Layout>