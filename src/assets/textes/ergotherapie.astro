---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import { equipeData } from '../data/equipe';

const { frontmatter } = Astro.props;
const titreService = frontmatter.titreService || frontmatter.title;
const sousTitre = frontmatter.sousTitre;

// Récupération des praticiens : 
// Le Markdown peut fournir soit un tableau d'identifiants (ex: praticiens: ["lydie-junon"]), soit un identifiant unique (praticienId)
let praticiensList = [];
if (frontmatter.praticiens && Array.isArray(frontmatter.praticiens)) {
  praticiensList = frontmatter.praticiens.map(id => equipeData[id]).filter(Boolean);
} else if (frontmatter.praticienId && equipeData[frontmatter.praticienId]) {
  praticiensList = [equipeData[frontmatter.praticienId]];
}
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <main class="py-12 px-4 max-w-4xl mx-auto">
    <!-- En-tête du service -->
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-stone-800 mb-2">{titreService}</h1>
      {sousTitre && <p class="text-xl text-amber-600 font-medium">{sousT titres || sousTitre}</p>}
    </header>

    <!-- Grille des praticiens rattachés au service -->
    {praticiensList.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {praticiensList.map((p) => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm flex items-center gap-6 text-left">
            {p.image ? (
              <a href={p.lien || "#"} class="block group shrink-0">
                <Image 
                  src={p.image} 
                  alt={`Portrait de ${p.nom}`} 
                  width={112} 
                  height={112} 
                  class="w-28 h-28 rounded-full object-cover border-4 border-stone-50 shadow-sm group-hover:scale-105 transition-transform duration-200" 
                />
              </a>
            ) : (
              <div class="w-28 h-28 rounded-full bg-stone-100 flex items-center justify-center text-stone-400 font-bold text-xl shrink-0">
                {p.nom.charAt(0)}
              </div>
            )}
            <div>
              <h3 class="text-xl font-bold text-stone-900 mb-1">
                <a href={p.lien || "#"} class="hover:text-amber-600 transition-colors">{p.nom}</a>
              </h3>
              <p class="text-stone-600 font-medium mb-3">{p.specialite}</p>
              {p.telephone && (
                <a href={`tel:${p.telephone.replace(/[^0-9+]/g, '')}`} class="inline-block bg-amber-50 text-amber-700 font-semibold text-sm px-3.5 py-1.5 rounded-full hover:bg-amber-100 transition-colors">
                  📞 {p.telephone}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Contenu de la page (Markdown) -->
    <article class="prose prose-stone max-w-none">
      <slot />
    </article>
  </main>
</Layout>